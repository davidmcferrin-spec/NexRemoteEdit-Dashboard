[Unit]
Description=NexEditorStats bridge (Jump + Telegraf + coturn)
After=network.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/nre-web/bridge
ExecStart=/opt/nre-web/venv/bin/python nre_bridge.py
Restart=always
RestartSec=5
StartLimitIntervalSec=0
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nre-bridge

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/nre-web/data

[Install]
WantedBy=multi-user.target
