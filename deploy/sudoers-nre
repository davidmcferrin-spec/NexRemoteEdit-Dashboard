# NexEditorStats - Bridge page (www-data via PHP).
# Installed as /etc/sudoers.d/nre-bridge. Validate with: visudo -cf
# journalctl * is one sudo argument - list the exact commands log.php runs.
www-data ALL=(ALL) NOPASSWD: /usr/bin/journalctl -u nre-bridge -n 50 --no-pager --output=short-iso
www-data ALL=(ALL) NOPASSWD: /usr/bin/journalctl -u nre-bridge -n 100 --no-pager --output=short-iso
www-data ALL=(ALL) NOPASSWD: /usr/bin/journalctl -u nre-bridge -n 200 --no-pager --output=short-iso
www-data ALL=(ALL) NOPASSWD: /usr/bin/journalctl -u nre-bridge -n 500 --no-pager --output=short-iso
www-data ALL=(ALL) NOPASSWD: /usr/bin/systemctl start nre-bridge
www-data ALL=(ALL) NOPASSWD: /usr/bin/systemctl stop nre-bridge
www-data ALL=(ALL) NOPASSWD: /usr/bin/systemctl restart nre-bridge
www-data ALL=(ALL) NOPASSWD: /usr/bin/systemctl is-active nre-bridge
